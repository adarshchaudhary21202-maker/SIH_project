# Development/testing can use SQLite. Production must use PostgreSQL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih_drug_tester
JWT_SECRET_KEY=replace-with-a-32-byte-or-longer-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-32-byte-or-longer-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
ED25519_PRIVATE_KEY=replace-with-a-32-byte-ed25519-private-key-in-hex
ED25519_PUBLIC_KEY=replace-with-the-matching-32-byte-public-key-in-hex
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ENVIRONMENT=development
AI_DEMO_MODE=true
# One of: PRESUMPTIVE_POSITIVE, PRESUMPTIVE_NEGATIVE, INCONCLUSIVE.
# This visibly selects a workflow demo state; it is not a chemical prediction.
AI_DEMO_PROFILE=INCONCLUSIVE
